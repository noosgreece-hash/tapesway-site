# tapesway console: environment variables.
# Copy to .env.local for local use (never commit it). On Vercel, set them under
# Project > Settings > Environment Variables.
# With nothing set, `npm run dev` runs in demo mode: password "demo", data in .data/,
# emails in the Outbox page.

# ---------- Login without Supabase (demo / single-password mode) ----------
# Required in production when Supabase is not configured; the console refuses to start without them.
# The owner's password (at least 10 characters).
CONSOLE_PASSWORD=
# Random secret that signs the session cookie (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it (or the password) signs everyone out.
SESSION_SECRET=

# ---------- Supabase (database, login, video storage) ----------
# Set all three to use Supabase instead of the local demo file. Found under
# Supabase > Project Settings > API. The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed into the console (Supabase login). Required with Supabase.
# The first one also receives new-lead alerts unless OWNER_ALERT_EMAIL is set.
OWNER_EMAILS=

# ---------- Email (Resend) ----------
# Without a key, emails are not sent: they are stored and shown on the "Outbox (demo)" page.
RESEND_API_KEY=
# Sender. The domain must be verified in Resend.
EMAIL_FROM="tapesway <hello@tapesway.com>"
# Optional: where client replies go.
EMAIL_REPLY_TO=
# Where new-lead alerts go. Defaults to the first OWNER_EMAILS address.
OWNER_ALERT_EMAIL=

# ---------- Addresses ----------
# The console's public address, used for links in emails (e.g. https://console.tapesway.com).
# If empty, the address of the current request is used.
PUBLIC_BASE_URL=
# Websites allowed to post the contact form to /api/leads (comma-separated).
# "http://localhost:*" allows any local port. Default:
# https://tapesway.com,https://www.tapesway.com,https://tapesway.gr,https://www.tapesway.gr,http://localhost:*,http://127.0.0.1:*
ALLOWED_ORIGINS=

# ---------- Tuning (optional) ----------
# Website form: at most LEADS_RATE_LIMIT messages per visitor IP per LEADS_RATE_WINDOW_SECONDS.
LEADS_RATE_LIMIT=5
LEADS_RATE_WINDOW_SECONDS=600
# How many clients are generated at the same time.
GENERATION_CONCURRENCY=2

# ---------- Demo mode only ----------
# Folder for the demo data file (store.json). Not suitable for Vercel (files there don't persist).
DATA_DIR=.data
# Set to 0 to start the demo without the sample leads and clients.
DEMO_SEED=1
# Pause per generated client in the demo generator, so progress is visible (milliseconds).
DEMO_GENERATOR_DELAY_MS=700
